{
  "name": "custardcream",
  "version": "1.0.0",
  "description": "커스텀 라이브러리 모음",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"pnpm build:watch\" \"pnpm --filter web dev\"",
    "build": "rm -rf packages/*/dist && rollup -c --bundleConfigAsCjs",
    "build:watch": "pnpm build --watch",
    "build:vscode": "rm -rf packages/vscode-*/dist && rollup --config rollup.vscode.config.mjs --bundleConfigAsCjs",
    "build:vscode:watch": "pnpm build:vscode --watch",
    "publish:react-gantt": "pnpm run build && pnpm --filter react-gantt publish --report-summary --access public",
    "publish:very-simple-store": "pnpm run build && pnpm --filter very-simple-store publish --report-summary --access public",
    "build:vscode:vsce": "pnpm run build:vscode && pnpm --filter vscode-* run build:vsce",
    "storybook": "NODE_ENV=development concurrently \"pnpm build:watch\" \"pnpm --filter ./apps/storybook storybook\"",
    "prepare": "husky install",
    "pre-commit": "pnpm --filter \"@custardcream/*\" pre-commit"
  },
  "keywords": [],
  "author": "shiwoo.park <custardcream@kakao.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@changesets/cli": "^2.31.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^11.1.6",
    "@swc/core": "^1.16.20",
    "@types/node": "20.5.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "pnpm": "^10.34.9",
    "prettier": "^3.9.10",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-styles": "^4.0.0",
    "rollup-plugin-swc3": "^0.10.4",
    "sass": "^1.107.0",
    "stylelint": "^15.11.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-prettier": "^4.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.3.0"
  },
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "resolutions": {
    "tsconfig-paths": "^4.2.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "decode-uri-component": "^0.5.0",
      "minimatch@^9.0.0": "^9.0.7",
      "minimatch@^3.0.0": "^3.1.4",
      "micromatch": "^4.0.8"
    }
  }
}
